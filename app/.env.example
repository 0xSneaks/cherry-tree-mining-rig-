# Cherry app registration. Obtain from Cherry; never hardcode (spec §8).
CHERRY_APP_ID=
# Optional: tighten launch-token verification to the deployed origin.
CHERRY_EXPECTED_ORIGIN=
# Defaults to https://chat.cherry.fun/.well-known/jwks.json when unset.
CHERRY_JWKS_URL=

# Solana RPC. Devnet for V1.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Explorer links in the transparency panel.
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet

# Server-side RPC for the indexer and cached global stats. Falls back to the
# public URL above when unset.
SOLANA_RPC_URL=
