# THE CHERRY TREE — example configuration.
#
# Copy to .env.local and fill in. Never put private-key bytes or a seed phrase
# in here: wallets are referenced by FILE PATH or PUBLIC KEY only.

# ---------------------------------------------------------------- cluster
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------- frontend
# NEXT_PUBLIC_ variables are compiled into the browser bundle. Only put
# values here that are meant to be public.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet

# ---------------------------------------------------------------- Cherry
# From Cherry mini-app registration. /api/session fails closed without it
# rather than accepting an unverified launch token.
CHERRY_APP_ID=
# Optional: pin launch-token verification to the deployed origin.
CHERRY_EXPECTED_ORIGIN=
# Defaults to https://chat.cherry.fun/.well-known/jwks.json when unset.
CHERRY_JWKS_URL=

# ---------------------------------------------------------------- growth layer (off-chain)
# All founder decisions. Every one fails closed when unset.
#
# Official Cherry Tree referral fallback: used only when a new planter arrives
# with NO ?ref= link and has no position yet, and only once this wallet is
# verified on chain as an existing planter. Binds the existing 1.05x referred
# weight; the official wallet receives nothing. Unset = no fallback.
NEXT_PUBLIC_CHERRY_TREE_OFFICIAL_REFERRER=
# Qualified-referral rule (server-side). Both required; unset = the referral
# leaderboard stays closed. Minimum fresh seeds must be >= 1.
CHERRY_TREE_REFERRAL_MIN_FRESH_SEEDS=
CHERRY_TREE_REFERRAL_MIN_HOLD_HOURS=
# Extra wallets never ranked on referral boards (comma/space separated).
CHERRY_TREE_EXCLUDED_REFERRERS=
# Season registry: JSON array, see docs/backlog/GROWTH.md. Unset = no seasons.
CHERRY_TREE_SEASONS_JSON=
# Runway alert thresholds in whole days (defaults 14 / 3).
CHERRY_TREE_RUNWAY_LOW_DAYS=
CHERRY_TREE_RUNWAY_CRITICAL_DAYS=
