# THE CHERRY TREE — deployment/operations configuration.
#
# Copy to .env (git-ignored) and fill in before running anything in scripts/.
#
# SECURITY: this file never holds key material. Wallets are referenced by
# FILE PATH (a keypair JSON you keep outside the repo) or by PUBLIC KEY.
# Never paste private-key bytes or a seed phrase into an env file.

# ---------------------------------------------------------------- cluster
# Scripts hard-fail on mainnet / mainnet-beta.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ------------------------------------------------- deployer / authority
# Standard Anchor wallet configuration. Path to a keypair JSON kept OUTSIDE
# this repository. This wallet pays for the deploy and becomes the program
# authority.
ANCHOR_WALLET=/absolute/path/to/cherry-tree-authority.json

# ------------------------------------------------------------ reward funder
# PUBLIC KEY of the only signer permitted to call fund_rewards. This is an
# independent role: it does NOT have to be the authority, and the deploy
# scripts never assume it is.
CHERRY_TREE_REWARD_FUNDER=

# Path to the reward funder's keypair, used ONLY by scripts/devnet-fund.ts.
# Keep it outside the repository. Omit it entirely on machines that only
# deploy or initialise.
CHERRY_TREE_REWARD_FUNDER_KEYPAIR=/absolute/path/to/cherry-tree-funder.json

# ------------------------------------------------------------ initial config
# Rig price in lamports. 10000000 = 0.01 SOL.
CHERRY_TREE_RIG_PRICE_LAMPORTS=10000000
# Disclosed purchase fee in basis points. 300 = 3.00%. Program caps this at 1000.
CHERRY_TREE_PURCHASE_FEE_BPS=300

# --------------------------------------------------------------- smoke test
# Two DISTINCT devnet wallets used by scripts/devnet-smoke.ts. Devnet SOL only.
CHERRY_TREE_SMOKE_WALLET_A=/absolute/path/to/smoke-a.json
CHERRY_TREE_SMOKE_WALLET_B=/absolute/path/to/smoke-b.json

# ---------------------------------------------------------------- Cherry
CHERRY_APP_ID=
CHERRY_EXPECTED_ORIGIN=
