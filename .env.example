# THE CHERRY TREE — deployment/operations configuration.
#
# Copy to .env (git-ignored) and fill in before running anything in scripts/.
#
# SECURITY: this file never holds key material. Wallets are referenced by
# FILE PATH (a keypair JSON you keep outside the repo) or by PUBLIC KEY.
# Never paste private-key bytes or a seed phrase into an env file.

# ---------------------------------------------------------------- cluster
# Scripts hard-fail on mainnet / mainnet-beta.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ------------------------------------------------- deployer / authority
# Standard Anchor wallet configuration. Path to a keypair JSON kept OUTSIDE
# this repository. This wallet pays for the deploy and becomes the program
# authority.
ANCHOR_WALLET=/absolute/path/to/cherry-tree-authority.json

# ------------------------------------------------------------ reward funder
# PUBLIC KEY of the only signer permitted to call fund_rewards. This is an
# independent role: it does NOT have to be the authority, and the deploy
# scripts never assume it is.
CHERRY_TREE_REWARD_FUNDER=

# Path to the reward funder's keypair, used ONLY by scripts/devnet-fund.ts.
# Keep it outside the repository. Omit it entirely on machines that only
# deploy or initialise.
CHERRY_TREE_REWARD_FUNDER_KEYPAIR=/absolute/path/to/cherry-tree-funder.json

# ----------------------------------------------------------- fee recipient
# PUBLIC KEY that protocol fees are withdrawable to. The program pins this as
# the ONLY account `withdraw_fees` may pay — the authority signs a withdrawal
# but cannot redirect it.
#
# This wallet NEVER signs, so no keypair for it belongs on any machine that
# runs these scripts, in CI, or anywhere in this repository.
CHERRY_TREE_FEE_RECIPIENT=FtuidxSaoNDeTuNTDuf9jLACVwqjgQeBwKTYC54f3GYp
# The founder wallet pinned forever at initialize: the verified sneaks.skr owner.
# The preflight re-reads sneaks.skr on chain; a mismatch fails closed.
CHERRY_TREE_FOUNDER=FtuidxSaoNDeTuNTDuf9jLACVwqjgQeBwKTYC54f3GYp

# ------------------------------------------------------------ initial config
# Rig price in lamports. 10000000 = 0.01 SOL.
CHERRY_TREE_RIG_PRICE_LAMPORTS=10000000
# Disclosed purchase fee in basis points. 300 = 3.00%. Program caps this at 1000.
CHERRY_TREE_PURCHASE_FEE_BPS=300

# --------------------------------------------------------------- smoke test
# Two DISTINCT devnet wallets used by scripts/devnet-smoke.ts. Devnet SOL only.
CHERRY_TREE_SMOKE_WALLET_A=/absolute/path/to/smoke-a.json
CHERRY_TREE_SMOKE_WALLET_B=/absolute/path/to/smoke-b.json

# ---------------------------------------------------------------- Cherry
# THE CHERRY TREE has TWO separate Cherry surfaces. They share a brand and
# nothing else — different SDKs, different auth, opposite directions.

# --- surface 1: the MINI APP (THE CHERRY TREE running inside Cherry) ---
# @cherrydotfun/miniapp-sdk. Issued by Cherry mini-app registration. Until it
# is set, the backend refuses to verify any launch token rather than accepting
# an unaudienced one.
CHERRY_APP_ID=
CHERRY_EXPECTED_ORIGIN=

# --- surface 2: the CHAT EMBED (Cherry chat running inside THE CHERRY TREE) ---
# @cherrydotfun/chat-embed-sdk, auth mode `app-trusted+wallet`.
#
# These two are PUBLIC identifiers — the SDK takes them in browser code — so
# they are NEXT_PUBLIC_ and appear in the client bundle by design.
#
# Created self-serve at portal.cherry.fun -> Project -> Chat embeds.
# The deployment origin MUST be listed in the embed's Allowed origins, or the
# iframe fails with an origin mismatch.
#
# Leave both blank to disable the embed entirely: the component renders
# nothing and the CSP keeps `frame-src 'none'`.
NEXT_PUBLIC_CHERRY_CHAT_APP_ID=ee009264-9c63-47cc-b346-46a44b25ff29
NEXT_PUBLIC_CHERRY_CHAT_ROOM_ID=934ad16c-61b7-4cdb-b015-cd61dd217df4

# The embed's app secret. SERVER-SIDE ONLY.
#
# It is an HMAC key: the backend signs the HS256 embed token with it at
# /api/cherry-embed-token. Shown once in the Cherry portal when you create or
# rotate the backend secret.
#
# NEVER give this a NEXT_PUBLIC_ prefix, never read it from client code, never
# commit it, never log it. Unset, the two /api/cherry-embed-* routes answer
# 503 and the chat stays in read-only preview — it does not fall back to a
# weaker mode.
#
# `app-trusted+wallet` needs those routes, so a deployment with the chat
# enabled must run Node. The static export refuses to build with the chat
# configured, rather than shipping a sign-in that 404s.
CHERRY_APP_SECRET=
